# Backend API base URL. Leave blank for local dev (Vite proxies /api to localhost:8787).
# On Vercel, set this to your Railway backend's public URL, e.g. https://xxxx.up.railway.app
VITE_API_BASE_URL=

# Google Sign-In — OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# Same value as the backend's GOOGLE_CLIENT_ID. Leave blank to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
