{
  "name": "AccountingTransaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "default": "income"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "bank_transfer",
        "mobile_banking",
        "cheque"
      ],
      "default": "cash"
    },
    "reference": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "amount",
    "date"
  ]
}