{
  "name": "BandwidthLog",
  "type": "object",
  "properties": {
    "log_date": {
      "type": "string",
      "format": "date"
    },
    "router_id": {
      "type": "string"
    },
    "router_name": {
      "type": "string"
    },
    "total_download_kbps": {
      "type": "number"
    },
    "total_upload_kbps": {
      "type": "number"
    },
    "active_sessions": {
      "type": "number"
    }
  },
  "required": [
    "log_date",
    "total_download_kbps",
    "total_upload_kbps"
  ]
}