{
  "name": "CableRoute",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "cable_type": {
      "type": "string",
      "enum": [
        "fiber",
        "utp",
        "coaxial",
        "drop_cable"
      ],
      "default": "fiber"
    },
    "color": {
      "type": "string",
      "description": "Hex color for the cable line"
    },
    "is_live": {
      "type": "boolean",
      "default": false,
      "description": "If true, the cable shows a flowing animation"
    },
    "path": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ]
      }
    },
    "start_lat": {
      "type": "number"
    },
    "start_lng": {
      "type": "number"
    },
    "end_lat": {
      "type": "number"
    },
    "end_lng": {
      "type": "number"
    },
    "length_meters": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}