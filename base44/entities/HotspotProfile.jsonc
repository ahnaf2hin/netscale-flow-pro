{
  "name": "HotspotProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "shared_users": {
      "type": "number",
      "default": 1
    },
    "rate_limit": {
      "type": "string"
    },
    "session_timeout": {
      "type": "string"
    },
    "validity": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "status"
  ]
}