{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "package_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "paid_amount": {
      "type": "number",
      "default": 0,
      "description": "Total amount paid so far (supports partial payments)"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "billing_month": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "paid",
        "unpaid",
        "overdue"
      ],
      "default": "unpaid"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "payment_method": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "amount",
    "due_date",
    "status"
  ]
}