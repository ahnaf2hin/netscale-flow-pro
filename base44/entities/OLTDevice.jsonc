{
  "name": "OLTDevice",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "vendor": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "snmp_community": {
      "type": "string",
      "default": "public"
    },
    "location": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "offline"
      ],
      "default": "online"
    },
    "total_pon_ports": {
      "type": "number"
    }
  },
  "required": [
    "name",
    "vendor",
    "ip_address"
  ]
}