{
  "name": "Package",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "speed_mbps": {
      "type": "number"
    },
    "monthly_price": {
      "type": "number"
    },
    "validity_days": {
      "type": "number",
      "default": 30
    },
    "description": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "speed_mbps",
    "monthly_price"
  ]
}