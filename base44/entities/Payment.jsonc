{
  "name": "Payment",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "gateway": {
      "type": "string",
      "enum": [
        "sslcommerz",
        "bkash",
        "nagad",
        "cash",
        "bank_transfer",
        "stripe"
      ],
      "default": "cash"
    },
    "transaction_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "collected_by": {
      "type": "string",
      "description": "Staff member who collected this payment"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "amount",
    "gateway"
  ]
}