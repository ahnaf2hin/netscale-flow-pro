{
  "name": "PaymentGateway",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "sslcommerz",
        "stripe",
        "bkash",
        "nagad",
        "cash",
        "bank_transfer"
      ],
      "default": "sslcommerz"
    },
    "display_name": {
      "type": "string"
    },
    "api_key": {
      "type": "string",
      "description": "Public identifier \u2014 Store ID (SSLCommerz), Publishable key (Stripe), etc."
    },
    "secret_key": {
      "type": "string",
      "description": "Secret credential \u2014 Store Password (SSLCommerz), Secret key (Stripe), etc."
    },
    "api_base": {
      "type": "string",
      "description": "API base URL. SSLCommerz sandbox: https://sandbox.sslcommerz.com | live: https://securepay.sslcommerz.com"
    },
    "mode": {
      "type": "string",
      "enum": [
        "sandbox",
        "live"
      ],
      "default": "sandbox"
    },
    "currency": {
      "type": "string",
      "default": "BDT"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "provider",
    "display_name",
    "mode",
    "is_active"
  ]
}