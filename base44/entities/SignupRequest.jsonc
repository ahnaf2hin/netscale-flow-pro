{
  "name": "SignupRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "package_id": {
      "type": "string"
    },
    "package_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "contacted"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    },
    "request_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "name",
    "phone",
    "status"
  ]
}