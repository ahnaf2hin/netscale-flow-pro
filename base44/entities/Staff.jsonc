{
  "name": "Staff",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "manager",
        "technician",
        "support",
        "billing"
      ],
      "default": "support"
    },
    "department": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "address": {
      "type": "string"
    },
    "salary": {
      "type": "number"
    },
    "join_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "name",
    "role",
    "status"
  ]
}