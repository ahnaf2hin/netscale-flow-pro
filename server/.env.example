PORT=8787

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=netscale
DB_PASSWORD=change-me
DB_NAME=netscale_flow_pro

JWT_SECRET=change-me-to-a-random-string

# Seed admin login (used only on first `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@netscale.local
SEED_ADMIN_PASSWORD=Admin@12345

# Shared secret the on-prem collector agent authenticates with (see collector/collector.js)
COLLECTOR_API_KEY=change-me

# --- Optional integrations (leave blank to keep everything in simulated/logged mode) ---

# SMTP (OTP emails, invoice/overdue notifications). Without this, OTPs are returned in
# the API response body (dev_otp) instead of emailed, so registration still works locally.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# bKash Tokenized Checkout — the PaymentGateway table only has room for App Key/App Secret,
# so the merchant username/password (bKash also requires these) live here instead.
# BKASH_USERNAME=
# BKASH_PASSWORD=

# Nagad — RSA keypair (PEM, with real newlines) for signing/encrypting checkout requests.
# NAGAD_MERCHANT_PRIVATE_KEY=
# NAGAD_PUBLIC_KEY=
